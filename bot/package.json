{
  "name": "club-bot",
  "version": "1.0.1",
  "description": "Клубный Telegram-бот с VPN-доступом через 3X-UI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:media-worker": "node dist/media-worker.js",
    "start:subscription": "node dist/subscription-server.js",
    "dev": "tsx src/index.ts",
    "dev:media-worker": "tsx src/media-worker.ts",
    "dev:subscription": "tsx src/subscription-server.ts",
    "dev:watch": "tsx watch src/index.ts",
    "import:telegram-directory": "tsx src/scripts/import-telegram-directory.ts",
    "import:telegram-messages": "tsx src/scripts/import-telegram-messages.ts",
    "sync:club-users": "tsx src/scripts/sync-known-club-users.ts",
    "sync:xray-users": "tsx src/scripts/sync-xray-users.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "telegraf": "^4.16.3",
    "tslog": "^4.9.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
