# Telegram
BOT_TOKEN=
CLUB_GROUP_ID=4021375237
SEED_ADMIN_ID=
VPN_BOT_TOKEN=
VPN_BOT_ADMIN_TELEGRAM_ID=
# Public sales stay off until terms, refund rules, and a canary payment are verified.
VPN_PAID_PAYMENTS_ENABLED=false
VPN_PAID_PRICE_STARS=100
VPN_PAID_TERMS_VERSION=
VPN_PAID_TERMS_URL=
# Trial start also requires the published terms above. Keep public launch off until canary verification.
VPN_TRIAL_ENABLED=false
VPN_TRIAL_NOTIFICATION_INTERVAL_MS=300000

# Event-driven access enforcement for satellite Telegram groups.
GROUP_ACCESS_ENABLED=false
GROUP_ACCESS_MANAGED_CHAT_IDS_JSON=[]
GROUP_ACCESS_GRACE_HOURS=24
GROUP_ACCESS_DUE_INTERVAL_MS=86400000

# 3X-UI
XUI_BASE_URL=http://server:2053
XUI_SUB_BASE_URL=https://server:2096
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1
VPN_XUI_SERVER_CODE=nl
VPN_XUI_SERVER_NAME=МОЖНО • Нидерланды
# JSON array of Xray nodes. Each item supports code, name, apiBaseUrl,
# subBaseUrl, rawSubBaseUrl, inboundId, username/password or apiToken,
# clientFlow, and clientApiMode (clients or legacy).
VPN_XUI_SERVERS_JSON=
VPN_XUI_MULTI_SERVER_CODE=nl
VPN_XUI_MULTI_SUB_BASE_URL=https://vpn.example.com
# 0 means unlimited traffic for the paid whitelist client.
# 0 is currently stored as an unset limit; paid whitelist provisioning defaults it to 10 GiB.
VPN_PAID_WHITELIST_TRAFFIC_LIMIT_GB=0
# 0 disables periodic traffic reset for the paid whitelist client.
VPN_PAID_WHITELIST_TRAFFIC_RESET_DAYS=30

# Combined Xray subscription service
XRAY_SUBSCRIPTION_HOST=0.0.0.0
XRAY_SUBSCRIPTION_PORT=18081
XRAY_SUBSCRIPTION_TITLE=МОЖНО VPN
XRAY_SUBSCRIPTION_SUPPORT_URL=https://t.me/example_bot
XRAY_SUBSCRIPTION_FILE_NAME=mozhno-vpn.txt
XRAY_SUBSCRIPTION_FILE_NAME_UTF8=МОЖНО VPN.txt
XRAY_SUBSCRIPTION_UPDATE_INTERVAL_HOURS=12
XRAY_TRAFFIC_SYNC_INTERVAL_MS=300000
XRAY_SUBSCRIPTION_JSON_USER_AGENT_PATTERN=(v2box|incy)
XRAY_SUBSCRIPTION_JSON_RU_DNS=77.88.8.8
XRAY_SUBSCRIPTION_JSON_REMOTE_DNS=https://1.1.1.1/dns-query
XRAY_SUBSCRIPTION_JSON_BLOCK_UDP_443=true
XRAY_SUBSCRIPTION_JSON_DIRECT_DOMAINS_JSON=
XRAY_SUBSCRIPTION_JSON_PRIVATE_IPS_JSON=

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=club_bot
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Media transcription through Alibaba Cloud Model Studio (Singapore region)
MEDIA_PROCESSING_ENABLED=true
MEDIA_WORKER_INTERVAL_MS=30000
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3
MEDIA_CONVERSION_TIMEOUT_MS=60000
MEDIA_IN_PROGRESS_STALE_MS=600000
MEDIA_RETENTION_DAYS=7
MEDIA_FAILED_RETENTION_DAYS=14
MEDIA_STORAGE_DIR=/app/media
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TRANSCRIPTION_MODEL=qwen3-asr-flash
QWEN_TRANSCRIPTION_LANGUAGE=ru
# Qwen3 ASR accepts at most 5 minutes per request; the worker splits longer audio.
QWEN_TRANSCRIPTION_CHUNK_SECONDS=290
# Base64 payload must stay below 10 MB, so binary chunks are capped at 7 MB.
QWEN_TRANSCRIPTION_MAX_FILE_SIZE_MB=7
QWEN_TRANSCRIPTION_TIMEOUT_MS=120000
QWEN_TRANSCRIPT_CLEANUP_MODEL=qwen-max
QWEN_TRANSCRIPT_CLEANUP_TIMEOUT_MS=60000

# VPN
VPN_SETUP_IMAGE_FILE_ID=
VPN_SETUP_IMAGE_FILE_ID_2=
